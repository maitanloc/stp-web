<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - STP</title>
    <meta name="description" content="Công cụ lọc, xem trước và in mục lục hồ sơ lưu trữ hàng loạt." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a'
                        }
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="bg-slate-100 text-slate-800 font-sans antialiased min-h-screen flex flex-col">
    <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm no-print">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            <a asp-page="/Index" class="flex items-center gap-3 min-w-0">
                <span class="w-10 h-10 rounded-lg bg-brand-700 flex items-center justify-center text-white shadow-sm shrink-0">
                    <i class="fa-solid fa-folder-tree text-lg"></i>
                </span>
                <span class="min-w-0">
                    <span class="block text-[10px] uppercase font-semibold tracking-wider text-slate-500">Hệ thống quản lý hồ sơ lưu trữ</span>
                    <span class="block text-base font-bold text-slate-900 leading-tight truncate">Công cụ lọc &amp; in mục lục hồ sơ</span>
                </span>
            </a>

            <nav class="hidden md:flex items-center gap-1 text-sm font-semibold">
                <a asp-page="/Index" class="px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 transition">
                    <i class="fa-solid fa-print mr-1.5 text-brand-600"></i>In hồ sơ
                </a>
                <a asp-page="/Statistics" class="px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 transition">
                    <i class="fa-solid fa-chart-column mr-1.5 text-brand-600"></i>Thống kê
                </a>
                <a asp-page="/Import" class="px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 transition">
                    <i class="fa-solid fa-file-import mr-1.5 text-brand-600"></i>Nhập Excel
                </a>
                <a asp-page="/Guide" class="px-3 py-2 rounded-lg text-slate-700 hover:bg-slate-100 transition">
                    <i class="fa-regular fa-circle-question mr-1.5 text-brand-600"></i>Hướng dẫn
                </a>
            </nav>

            <div class="hidden sm:flex items-center gap-2 shrink-0">
                <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-semibold bg-emerald-100 text-emerald-800">
                    <span class="w-1.5 h-1.5 mr-1.5 bg-emerald-500 rounded-full"></span>
                    Sẵn sàng in A4
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @RenderBody()
    </main>

    <footer class="bg-white border-t border-slate-200 py-4 mt-auto no-print text-center text-xs text-slate-500">
        <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-2">
            <p>© 2026 · Công cụ lọc &amp; in mục lục hồ sơ lưu trữ</p>
            <p class="text-slate-400">Bản web hóa từ bảng tính Excel · Dữ liệu lưu cục bộ trên máy chủ</p>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
