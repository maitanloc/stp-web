{
  "ConnectionStrings": {
    "StpArchive": "Server=localhost;Database=StpArchive;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Storage": {
    "RootPath": "data",
    "MaxUploadBytes": 209715200,
    "MaxFilesPerJob": 50,
    "AllowedExtensions": [ ".xlsx", ".xlsm", ".xltx", ".xltm" ]
  },
  "PrintLayout": {
    "HeaderText": "",
    "FooterText": ""
  },
  "ExcelCom": {
    "PreferredHost": "Auto",
    "StartupTimeoutSeconds": 120,
    "ReuseSession": true,
    "EnableAccessVbom": true
  },
  "ExcelVba": {
    "Enabled": true
  },
  "StpTeam": {
    "RequireLogin": false,
    "AllowRegistration": true
  },
  "DeveloperAuth": {
    "PasswordHash": "",
    "JwtKey": "",
    "Issuer": "StpArchive.Developer",
    "Audience": "StpArchive.DeveloperUi",
    "TokenLifetimeMinutes": 480,
    "StateFilePath": "data/runtime/developer-auth.json",
    "MaxFailedAttempts": 5,
    "FailedAttemptWindowMinutes": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
