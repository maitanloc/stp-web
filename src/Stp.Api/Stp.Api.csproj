<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Stp.Core\Stp.Core.csproj" />
    <ProjectReference Include="..\Stp.Contracts\Stp.Contracts.csproj" />
    <ProjectReference Include="..\Stp.Infrastructure\Stp.Infrastructure.csproj" />
  </ItemGroup>

  <!--
    Giao diện SPA: "npm run build" ở src/Stp.Web tạo dist/, target này dồn vào
    wwwroot để API serve trọn gói một cổng (share link được luôn).
    Chưa npm build lần nào thì bỏ qua — API vẫn chạy thuần như cũ.
  -->
  <Target Name="CopySpaDistToWwwroot" AfterTargets="Build"
          Condition="Exists('$(MSBuildThisFileDirectory)..\Stp.Web\dist\index.html')">
    <ItemGroup>
      <SpaAsset Include="$(MSBuildThisFileDirectory)..\Stp.Web\dist\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SpaAsset)"
          DestinationFiles="@(SpaAsset->'$(MSBuildThisFileDirectory)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
