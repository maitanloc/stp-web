# Build output
bin/
obj/
publish/
*.user
*.suo
.vs/

# Runtime data: contains personal archive records, never commit or publish
App_Data/*
!App_Data/.gitkeep
*.xlsx
*.xlsm
*.pdf
*.tmp

# Logs
*.log

# Runtime data, uploads, outputs, backups
data/
logs/
artifacts/
*.bak
*.db
*.sqlite

# Node / SPA
node_modules/
dist/
.env
.env.*
!.env.example

# Clean Excel template may be committed (no personal data)
!src/Stp.Infrastructure/Excel/Templates/*.xlsm

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# SPA build output (target CopySpaDistToWwwroot sinh lai tu Stp.Web/dist)
src/Stp.Api/wwwroot/

# Windows service wrapper (WinSW) + logs — chỉ giữ trên máy, không commit
service/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
